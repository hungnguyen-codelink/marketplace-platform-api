# PostgreSQL connection string. Required — no default.
# Format: postgresql://user:password@host:port/database
# Purpose: Primary database connection for marketplace data (products, reviews, orders).
# Production: use strong credentials and a managed database service (e.g., AWS RDS, Heroku Postgres).
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace

# Redis connection URL. Default: redis://localhost:6379
# Purpose: caching (category data), sessions, rate limiting, and cart state.
# Valid format: redis://[:password@]host[:port][/db-number]
# Production: use a managed Redis service (e.g., Redis Cloud, AWS ElastiCache, Heroku Redis).
REDIS_URL=redis://localhost:6379

# JWT secret key for signing authentication tokens. Required — no default.
# Purpose: cryptographic key for signing and verifying JSON Web Tokens (auth, session tokens).
# Valid range: minimum 32 characters recommended for security.
# Production: generate a strong random string (e.g., openssl rand -base64 32); use a secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault).
JWT_SECRET=change-me-in-production

# Session time-to-live in seconds. Default: 86400 (24 hours).
# Purpose: controls how long user sessions remain valid before requiring re-authentication.
# Valid range: recommend 3600 (1 hour) to 604800 (7 days) depending on security requirements.
# Accepted values: any positive integer representing seconds.
SESSION_TTL_SECONDS=86400

# Rate limiting window duration in milliseconds. Default: 900000 (15 minutes).
# Purpose: time window for rate limit checks on API endpoints.
# Valid range: recommend 60000 (1 min) to 3600000 (1 hour) depending on API usage patterns.
# Accepted values: any positive integer representing milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per rate limit window. Default: 100.
# Purpose: max number of requests a client can make within RATE_LIMIT_WINDOW_MS before being throttled.
# Valid range: recommend 10 to 1000 depending on API load and security requirements.
# Accepted values: any positive integer.
RATE_LIMIT_MAX_REQUESTS=100

# Fakestore API base URL. Default: https://fakestoreapi.com
# Purpose: endpoint for fetching mock product catalog (used in development and integration tests).
# Valid format: valid HTTP or HTTPS URL.
# Production: in production, replace with your actual product data source or internal API.
FAKESTORE_BASE_URL=https://fakestoreapi.com

# Fakestore category cache TTL in seconds. Default: 3600 (1 hour).
# Purpose: controls how long category data from Fakestore is cached in Redis before refetching.
# Valid range: recommend 1800 (30 min) to 86400 (24 hours) for stability vs freshness trade-off.
# Accepted values: any positive integer representing seconds.
FAKESTORE_CATEGORY_CACHE_TTL_SECONDS=3600

# HTTP request timeout for Fakestore API calls in milliseconds. Default: 5000 (5 seconds).
# Purpose: maximum duration to wait for Fakestore API responses before timing out.
# Valid range: recommend 2000 (2 sec) to 30000 (30 sec) depending on network conditions.
# Accepted values: any positive integer representing milliseconds.
FAKESTORE_TIMEOUT_MS=5000

# Number of retry attempts for failed Fakestore API requests. Default: 3.
# Purpose: resilience mechanism to recover from transient failures (network hiccups, temporary unavailability).
# Valid range: recommend 1 to 5 attempts.
# Accepted values: any non-negative integer (0 = no retries, 1 = one retry after initial attempt).
FAKESTORE_RETRY_ATTEMPTS=3

# Initial backoff time for Fakestore API retries in milliseconds. Default: 500 (500ms).
# Purpose: delay before first retry; subsequent retries use exponential backoff (backoff * 2^attempt).
# Valid range: recommend 100 (0.1 sec) to 5000 (5 sec); larger values reduce thundering herd effect.
# Accepted values: any positive integer representing milliseconds.
FAKESTORE_RETRY_BACKOFF_MS=500

# Backend HTTP server port. Default: 3000.
# Purpose: port on which the Node.js backend server listens for incoming HTTP requests.
# Valid range: recommend 3000–8000 for development; in production, use ports above 1024.
# Accepted values: any valid port number (0 = let OS assign, 1–1023 = privileged, 1024+ = unprivileged).
PORT=3000
